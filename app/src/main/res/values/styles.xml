<resources>
    <!-- White text, for darker card backgrounds -->
    <style name="CardTitleWhite">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:alpha">0.9</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="CardValueWhite">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- Dark text, for lighter/brighter card backgrounds (better contrast) -->
    <style name="CardTitleDark">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#2B2B2B</item>
        <item name="android:alpha">0.75</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="CardValueDark">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#2B2B2B</item>
    </style>

    <!-- Standalone icon glyph, white variant -->
    <style name="CardIconWhite">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Standalone icon glyph, dark variant -->
    <style name="CardIconDark">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>
